{
  "expo": {
    "name": "E_Office",
    "slug": "E_Office",
    "version": "1.0.3",
    "runtimeVersion": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ebf1fd"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/d826ce4b-d12c-4564-91f1-e2a17b214dba"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vigorous.E-Office"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.vigorous.E_Office",
      "googleServicesFile": "./google-services.json",
      "versionCode": 6,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications"
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow E-Office to access your photos.",
          "savePhotosPermission": "Allow E-Office to save documents to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "55b3b0ab-f862-4087-bd36-63bcdd3980b7"
      }
    }
  }
}
